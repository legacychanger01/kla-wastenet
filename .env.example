# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-minimum-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.development

# ─── Database ─────────────────────────────────────────────────────────────────
# Option 1: SQLite (default — zero config, great for development & small deployments)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=kla_wastenet.db

# Option 2: MySQL (uncomment and install mysqlclient for production)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=kla_wastenet_db
# DB_USER=kla_user
# DB_PASSWORD=your-strong-password
# DB_HOST=localhost
# DB_PORT=3306
# DB_CONN_MAX_AGE=60

# ─── Redis (optional — falls back gracefully if not available) ────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@klawastenet.go.ug
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=KLA WasteNet <noreply@klawastenet.go.ug>

# ─── MTN Mobile Money ─────────────────────────────────────────────────────────
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_PRIMARY_KEY=your-mtn-primary-key
MTN_MOMO_API_USER=your-api-user-uuid
MTN_MOMO_API_KEY=your-mtn-api-key
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=UGX

# ─── Airtel Money ─────────────────────────────────────────────────────────────
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CURRENCY=UGX

# ─── Flutterwave ──────────────────────────────────────────────────────────────
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key
FLW_ENCRYPTION_KEY=your-encryption-key
FLW_BASE_URL=https://api.flutterwave.com/v3

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+256xxxxxxxxx

# ─── Africa's Talking ─────────────────────────────────────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=KLAWaste

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FCM_SERVER_KEY=your-fcm-server-key
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Security ─────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# ─── App Config ───────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000
WASTE_PICKUP_BASE_FEE=15000
SUBSCRIPTION_MONTHLY_FEE=45000
SUBSCRIPTION_QUARTERLY_FEE=120000
SUBSCRIPTION_ANNUAL_FEE=420000
